/*
========================================================================================
    SSUextract Nextflow Configuration
========================================================================================
    Default configuration for SSUextract pipeline
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // Input/output options
    query                      = 'data/example'
    modeldir                   = 'resources/models'
    database_path              = 'resources/database'
    database_profile           = 'curated'
    model_marker_map           = 'config/model_markers.json'

    // Pipeline parameters
    min_extract_length         = 500
    threads_per_job            = 2
    max_blast_targets          = 500
    top_hits                   = 5
    tree_classification        = false
    tree_reference_count       = 100
    tree_assignment_neighbors  = 5
    tree_trim_gap_fraction     = 0.9

    // Boilerplate options
    help                       = false
    version                    = false

    // Max resource options
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'
}

// Default output directory: results/<input directory name or FASTA file stem>.
// A FASTA suffix is removed only when --query is a file.
params.outdir = params.outdir ?: {
    def query_input = new File(params.query.toString())
    def fasta_name = query_input.name =~ /^(.+)\.(fna|fa|fasta)$/
    def query_name = query_input.isFile() && fasta_name.matches() ? fasta_name.group(1) : query_input.name
    return "results/${query_name}"
}()

// One timestamp for all report file names of this run.
params.report_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

// Load base configuration
includeConfig 'config/base.config'

// Keep user-site Python packages out of the pipeline environment.
env {
    PYTHONNOUSERSITE = 1
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.report_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.report_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.report_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.report_timestamp}.html"
}

manifest {
    name            = 'NeLLi-team/ssuextract'
    author          = 'Frederik Schulz'
    homePage        = 'https://github.com/NeLLi-team/ssuextract'
    description     = 'SSU rRNA extraction pipeline using covariance models'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.2.2'
    doi             = ''
}
