/*
========================================================================================
    Base Configuration for SSUextract Pipeline
========================================================================================
    Default configuration for all processes
----------------------------------------------------------------------------------------
*/

process {
    // Hard per-task ceilings; retry scaling below is clamped to them.
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time]

    // Global process configuration
    cpus   = { 1 * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements and error handling
    withName:CMSEARCH {
        cpus   = { (params.threads_per_job as int) * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    
    withName:EXTRACT_HITS {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    
    withName:BLAST_ANNOTATE {
        cpus   = { (params.threads_per_job as int) * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName:PREPARE_TREE_TASKS {
        cpus   = { (params.threads_per_job as int) * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName:TREE_CLASSIFY {
        cpus   = { (params.threads_per_job as int) * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    
    withName:FINALIZE_SUMMARIES {
        cpus   = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
}
